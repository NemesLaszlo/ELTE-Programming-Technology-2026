<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>hu.elte.progtech</groupId>
    <artifactId>Dodger</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Dodger</name>
    <description>Dodger – sprite-játék elemi grafikával, WASD-irányítással, időzítővel és adatbázisba mentett ranglistával (SQLite vagy MySQL)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- A nyelvi szint: JDK 17. A projekt minden újabb JDK-n (21, 25, ...)
             is fordul és fut. -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- A főosztály. NetBeansben a Run (F6) az nbactions.xml alapján indul,
             IntelliJ-ben a .run/Dodger.run.xml alapján, parancssorból az
             "mvn compile exec:java" és a "java -jar" ezt használja. -->
        <exec.mainClass>dodger.Dodger</exec.mainClass>
    </properties>

    <dependencies>
        <!-- JUnit 4: csak a tesztekhez kell, a kész programba nem kerül bele.
             Ugyanaz, mint a 4. heti Race és a 8. heti ColorclickerOptimized tesztjeinél. -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <!-- SQLite JDBC-driver: az adatbázis egyetlen fájl, nem kell hozzá
             szerver. Ez az alapértelmezett (ld. Database.java). -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.54.1.0</version>
        </dependency>
        <!-- MySQL JDBC-driver: a Dockerben futó MySQL-szerverhez. Benne hagyjuk,
             hogy a Database.java-ban elég legyen a kapcsolat adatait átírni. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>26.10.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Minden figyelmeztetést kérünk a fordítótól. -->
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- A tesztek is a SQLite-drivert használják (natív könyvtár):
                         a JDK 24+ figyelmeztetése nélkül fussanak. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!-- A programnak futás közben kell a JDBC-driver (a SQLite és a
                     MySQL jar), ezért a sima jar nem elég: a shade plugin egyetlen
                     "kövér" jarba csomagolja a programot és a függőségeit, és
                     beleírja a főosztályt is. A kövér jar KÜLÖN fájl (-all), a
                     sima jar is megmarad (a NetBeans ezt várja el). Így futtatható:
                     java -jar target/Dodger-1.0-SNAPSHOT-all.jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${exec.mainClass}</mainClass>
                                    <manifestEntries>
                                        <!-- A "java -jar" indításhoz: a SQLite-driver natív
                                             könyvtárat tölt be, ezt a JDK 24+ csak így engedi
                                             figyelmeztetés nélkül. -->
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <!-- A függőségek aláírás-fájljai a kövér jarban csak zavarnának. -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Futtatás parancssorból, fordítás után (Windowson és macOS-en is):
                     mvn compile exec:java -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
