<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>hu.elte.progtech</groupId>
    <artifactId>Colorclicker</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Colorclicker</name>
    <description>Color clicker – táblás ügyességi játék, kiinduló (nem optimalizált) változat</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- A nyelvi szint: JDK 17. A projekt minden újabb JDK-n (21, 25, ...)
             is fordul és fut. -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- A főosztály. NetBeansben a Run (F6) az nbactions.xml alapján indul,
             IntelliJ-ben a .run/Colorclicker.run.xml alapján, parancssorból az
             "mvn compile exec:java" és a "java -jar" ezt használja. -->
        <exec.mainClass>colorclicker.Colorclicker</exec.mainClass>
    </properties>

    <!-- Nincs függőség: a Swing a JDK része. Teszt sincs: a kiinduló változat
         szabályai a felülethez kötődnek, JUnit-tal nem ellenőrizhetők (ld. README). -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Minden figyelmeztetést kérünk a fordítótól. -->
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <!-- A jar fájlba beírjuk a főosztályt, így futtatható:
                     java -jar target/Colorclicker-1.0-SNAPSHOT.jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${exec.mainClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <!-- Futtatás parancssorból, fordítás után (Windowson és macOS-en is):
                     mvn compile exec:java -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
